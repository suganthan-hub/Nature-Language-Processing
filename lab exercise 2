        "def automaton(s):\n",
        "    state = 0\n",
        "\n",
        "    for ch in s:\n",
        "        if state == 0:\n",
        "            state = 1 if ch == 'a' else 0\n",
        "        elif state == 1:\n",
        "            state = 1 if ch == 'a' else 2\n",
        "        elif state == 2:\n",
        "            state = 1 if ch == 'a' else 0\n",
        "\n",
        "    return state == 2\n",
        "\n",
        "s = input(\"Enter a string: \")\n",
        "\n",
        "if automaton(s):\n",
        "    print(\"Accepted\")\n",
        "else:\n",
        "    print(\"Rejected\")"
      ]
