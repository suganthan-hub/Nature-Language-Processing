        "def vowel_groups(word):\n",
        "    vowels = \"aeiou\"\n",
        "    count = 0\n",
        "    inside = False\n",
        "\n",
        "    for c in word:\n",
        "        if c in vowels:\n",
        "            if not inside:\n",
        "                count += 1\n",
        "            inside = True\n",
        "        else:\n",
        "            inside = False\n",
        "\n",
        "    return count\n",
        "\n",
        "\n",
        "def doublable(word):\n",
        "    if len(word) < 3:\n",
        "        return False\n",
        "\n",
        "    vowels = \"aeiou\"\n",
        "\n",
        "    if not (\n",
        "        word[-3] not in vowels\n",
        "        and word[-2] in vowels\n",
        "        and word[-1] not in vowels\n",
        "    ):\n",
        "        return False\n",
        "\n",
        "    if word[-1] in \"wxy\":\n",
        "        return False\n",
        "\n",
        "    return vowel_groups(word) == 1\n",
        "\n",
        "\n",
        "def inflect(stem, feature):\n",
        "    if feature in (\"N+PL\", \"V+3SG\"):\n",
        "        if stem.endswith((\"s\", \"x\", \"z\", \"ch\", \"sh\")):\n",
        "            return stem + \"es\"\n",
        "\n",
        "        if len(stem) >= 2 and stem.endswith(\"o\"):\n",
        "            if stem[-2] not in \"aeiou\":\n",
        "                return stem + \"es\"\n",
        "\n",
        "        if len(stem) >= 2 and stem.endswith(\"y\"):\n",
        "            if stem[-2] not in \"aeiou\":\n",
        "                return stem[:-1] + \"ies\"\n",
        "\n",
        "        return stem + \"s\"\n",
        "\n",
        "    if feature == \"V+PROG\":\n",
        "        if (len(stem) >= 3 and stem.endswith(\"e\")\n",
        "                and stem[-2] not in \"aeiou\"):\n",
        "            return stem[:-1] + \"ing\"\n",
        "\n",
        "        if doublable(stem):\n",
        "            return stem + stem[-1] + \"ing\"\n",
        "\n",
        "        return stem + \"ing\"\n",
        "\n",
        "    suffix = {\n",
        "        \"V+PAST\": \"ed\",\n",
        "        \"ADJ+COMP\": \"er\",\n",
        "        \"ADJ+SUP\": \"est\"\n",
        "    }[feature]\n",
        "\n",
        "    if stem.endswith(\"e\"):\n",
        "        return stem + suffix[1:]\n",
        "\n",
        "    if len(stem) >= 2 and stem.endswith(\"y\"):\n",
        "        if stem[-2] not in \"aeiou\":\n",
        "            return stem[:-1] + \"i\" + suffix\n",
        "\n",
        "    if doublable(stem):\n",
        "        return stem + stem[-1] + suffix\n",
        "\n",
        "    return stem + suffix\n",
        "\n",
        "\n",
        "L = int(input())\n",
        "lexicon = {}\n",
        "\n",
        "for _ in range(L):\n",
        "    stem, feature, form = input().split()\n",
        "    lexicon[(stem, feature)] = form\n",
        "\n",
        "Q = int(input())\n",
        "\n",
        "for _ in range(Q):\n",
        "    stem, feature = input().split()\n",
        "\n",
        "    if (stem, feature) in lexicon:\n",
        "        print(lexicon[(stem, feature)])\n",
        "    else:\n",
        "        print(inflect(stem, feature))"
