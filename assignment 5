        "# 3. Centering Theory Implementation & Trace (Task 2)\n",
        "def centering_analysis(utterances_entities):\n",
        "    \"\"\"\n",
        "    Ranks Forward-Looking Centers Cf(U_n) by grammatical role: SUBJ > OBJ > OBLIQUE.\n",
        "    Identifies Backward-Looking Center Cb(U_n) and transitions (Continue, Retain, Smooth-Shift, Rough-Shift).\n",
        "    \"\"\"\n",
        "    results = []\n",
        "    prev_cf = []\n",
        "    prev_cb = None\n",
        "    for idx, (utt_text, ents) in enumerate(utterances_entities):\n",
        "        # ents = list of (entity_name, role)\n",
        "        role_rank = {\"SUBJ\": 1, \"OBJ\": 2, \"OBL\": 3}\n",
        "        cf = [e for e, _ in sorted(ents, key=lambda x: role_rank.get(x[1], 4))]\n",
        "        cp = cf[0] if cf else None\n",
        "        if idx == 0:\n",
        "            cb = None\n",
