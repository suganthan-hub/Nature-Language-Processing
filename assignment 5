        "\n",
        "# 2. Hobbs' Algorithm Implementation & Trace (Task 2)\n",
        "def hobbs_resolve(trees, pronoun_leaf=\"It\"):\n",
        "    \"\"\"\n",
        "    Implements Hobbs' left-to-right breadth-first tree search on syntactic parse trees:\n",
        "    Step 1: Start at NP dominating pronoun, climb to first S/NP node X.\n",
        "    Step 2: Traverse branches below X left-to-right (breadth-first) respecting binding.\n",
