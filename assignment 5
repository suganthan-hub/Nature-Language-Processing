        "# 2. Statistical Machine Translation: IBM Model 1 with EM (Task 9)\n",
        "def train_ibm_model1(bitext, iterations=5):\n",
        "    \"\"\"Estimates lexical translation probabilities t(f|e) using Expectation-Maximization.\"\"\"\n",
        "    en_vocab = set()\n",
        "    fr_vocab = set()\n",
        "    pairs = []\n",
        "    for en_s, fr_s in bitext:\n",
        "        e_toks = [\"NULL\"] + en_s.lower().split()\n",
        "        f_toks = fr_s.split()\n",
        "        en_vocab.update(e_toks)\n",
        "        fr_vocab.update(f_toks)\n",
        "        pairs.append((e_toks, f_toks))\n",
        "\n",
        "    # Uniform initialization: t(f|e) = 1 / |V_target|\n",
        "    t = defaultdict(lambda: 1.0 / len(fr_vocab))\n",
        "    iter1_snapshot = {}\n",
        "\n",
        "    for it in range(1, iterations + 1):\n",
        "        count = defaultdict(float)\n",
        "        total = defaultdict(float)\n",
        "        for e_toks, f_toks in pairs:\n",
        "            # E-step: compute alignment normalization z\n",
        "            for f in f_toks:\n",
        "                z = sum(t[(f, e)] for e in e_toks)\n",
        "                for e in e_toks:\n",
        "                    c = t[(f, e)] / z\n",
        "                    count[(f, e)] += c\n",
        "                    total[e] += c\n",
        "        # M-step: re-estimate t(f|e)\n",
        "        for (f, e), c_val in count.items():\n",
        "            t[(f, e)] = c_val / total[e]\n",
        "        if it == 1:\n",
        "            iter1_snapshot = dict(t)\n",
        "    return t, iter1_snapshot\n",
