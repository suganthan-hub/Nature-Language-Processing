        "        else:\n",
        "            cb = next((e for e in cf if e in prev_cf), None)\n",
        "            if cb == prev_cb and cb == cp:\n",
        "                trans = \"CONTINUE\"\n",
        "            elif cb == prev_cb and cb != cp:\n",
        "                trans = \"RETAIN\"\n",
        "            elif cb != prev_cb and cb == cp:\n",
        "                trans = \"SMOOTH-SHIFT\"\n",
        "            else:\n",
        "                trans = \"ROUGH-SHIFT\"\n",
        "        results.append({\"utt\": utt_text, \"Cf\": cf, \"Cp\": cp, \"Cb\": cb, \"Transition\": trans})\n",
        "        prev_cf = cf\n",
        "        prev_cb = cb\n",
