        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "import numpy as np\n",
        "\n",
        "documents = [\n",
        "    \"Every employee completing ten years of qualifying service gets a pension.\",\n",
        "    \"Family pension is payable to the surviving spouse after death.\",\n",
        "    \"Commutation allows converting forty percent of monthly pension into a lump sum.\",\n",
        "    \"Heavy monsoon rain caused severe waterlogging near the subway.\"\n",
        "]\n",
        "query = [\"qualifying service years for pension\"]\n",
        "\n",
        "vectorizer = TfidfVectorizer(stop_words=\"english\")\n",
        "doc_vectors = vectorizer.fit_transform(documents)\n",
        "query_vector = vectorizer.transform(query)\n",
        "\n",
        "scores = cosine_similarity(query_vector, doc_vectors).flatten()\n",
        "ranked_indices = np.argsort(scores)[::-1]\n",
        "\n",
        "for rank, idx in enumerate(ranked_indices, 1):\n",
        "    print(f\"Rank {rank} (Score={scores[idx]:.4f}): {documents[idx]}\")"
      ],
