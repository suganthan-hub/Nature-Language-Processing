        "import spacy\n",
        "\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "def evaluate_coherence(text):\n",
        "    doc = nlp(text)\n",
        "    sents = list(doc.sents)\n",
        "    sent_entities = [{tok.lemma_.lower() for tok in s if tok.pos_ in (\"NOUN\", \"PROPN\")} for s in sents]\n",
        "\n",
        "    overlaps = 0\n",
        "    for s1, s2 in zip(sent_entities[:-1], sent_entities[1:]):\n",
        "        if s1.intersection(s2):\n",
        "            overlaps += 1\n",
        "    score = overlaps / max(len(sents) - 1, 1)\n",
        "    return round(score, 2)\n",
        "\n",
        "coherent_text = \"Water flooded Tambaram Subway. Police closed the subway. Drivers avoided the subway.\"\n",
        "incoherent_text = \"Water flooded Tambaram Subway. Apples grow in Himachal. Computers use binary code.\"\n",
        "\n",
        "print(\"Coherent text score  :\", evaluate_coherence(coherent_text))\n",
        "print(\"Incoherent text score:\", evaluate_coherence(incoherent_text))"
