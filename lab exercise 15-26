        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "text = \"A huge tree fell across Adyar Bridge. It blocked the ambulance lane.\"\n",
        "doc = nlp(text)\n",
        "\n",
        "# Track most recent singular noun-phrase subject/entity for inanimate pronoun resolution\n",
        "last_entity = None\n",
        "for sent in doc.sents:\n",
        "    for token in sent:\n",
        "        if token.pos_ in (\"NOUN\", \"PROPN\") and token.dep_ in (\"nsubj\", \"pobj\", \"dobj\"):\n",
        "            last_entity = token.text\n",
        "        elif token.pos_ == \"PRON\" and token.text.lower() == \"it\" and last_entity:\n",
        "            print(f\"Pronoun '{token.text}' in '{sent.text}' -> Resolved to '{last_entity}'\")"
