    {
      "cell_type": "code",
      "source": [
        "from collections import defaultdict, Counter\n",
        "\n",
        "# Training sentences: (word, tag)\n",
        "train_data = [\n",
        "    [(\"the\", \"DT\"), (\"dog\", \"NN\"), (\"barks\", \"VBZ\")],\n",
        "    [(\"a\", \"DT\"), (\"cat\", \"NN\"), (\"runs\", \"VBZ\")],\n",
        "    [(\"dogs\", \"NNS\"), (\"bark\", \"VBP\"), (\"loudly\", \"RB\")],\n",
        "    [(\"the\", \"DT\"), (\"cat\", \"NN\"), (\"sleeps\", \"VBZ\")]\n",
        "]\n",
        "\n",
        "word_tag_counts = defaultdict(Counter)\n",
        "for sent in train_data:\n",
        "    for word, tag in sent:\n",
        "        word_tag_counts[word.lower()][tag] += 1\n",
        "\n",
        "def stochastic_tagger(sentence):\n",
        "    tags = []\n",
        "    for w in sentence.lower().split():\n",
        "        if w in word_tag_counts:\n",
        "            # Choose tag maximizing P(tag | word)\n",
        "            best_tag = word_tag_counts[w].most_common(1)[0][0]\n",
        "        else:\n",
        "            best_tag = \"NN\"  # Most frequent fallback tag\n",
        "        tags.append((w, best_tag))\n",
        "    return tags\n",
        "\n",
        "print(stochastic_tagger(\"The dog sleeps loudly\"))"
      ],
