        "# Step 1: Initial baseline tagging (assign 'NN' to unknown words, 'TO' to 'to')\n",
        "initial_tags = [(\"We\", \"PRP\"), (\"want\", \"VBP\"), (\"to\", \"TO\"), (\"race\", \"NN\"), (\"the\", \"DT\"), (\"car\", \"NN\")]\n",
        "\n",
        "# Step 2: Transformation rule -> Change 'NN' to 'VB' if the preceding tag is 'TO'\n",
        "def apply_transformation_rules(tagged_sent):\n",
        "    result = list(tagged_sent)\n",
        "    for i in range(1, len(result)):\n",
        "        word, tag = result[i]\n",
        "        prev_word, prev_tag = result[i - 1]\n",
        "        if tag == \"NN\" and prev_tag == \"TO\":\n",
        "            result[i] = (word, \"VB\")\n",
        "    return result\n",
        "\n",
        "print(\"Before rule:\", initial_tags)\n",
        "print(\"After rule :\", apply_transformation_rules(initial_tags))"
