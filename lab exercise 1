      "source": [
        "import re\n",
        "\n",
        "text = \"My email is student@gmail.com and my number is 9876543210\"\n",
        "\n",
        "emails = re.findall(r'[\\w.-]+@[\\w.-]+\\.\\w+', text)\n",
        "numbers = re.findall(r'\\d{10}', text)\n",
        "words = re.findall(r'\\b[A-Za-z]+\\b', text)\n",
        "\n",
        "print(\"Emails:\", emails)\n",
        "print(\"Phone Numbers:\", numbers)\n",
        "print(\"Words:\", words)"
      ]
