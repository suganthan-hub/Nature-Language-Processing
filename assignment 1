        "\n",
        "# NLP ASSIGNMENT 1\n",
        "# Morphology-Aware Text Normalisation\n",
        "# Hospital Record System\n",
        "\n",
        "import re\n",
        "import nltk\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "from nltk.stem import PorterStemmer\n",
        "from sklearn.metrics import precision_score, recall_score, f1_score\n",
        "\n",
        "# Download NLTK resources\n",
        "nltk.download('punkt', quiet=True)\n",
        "\n",
        "start = time.time()\n",
        "\n",
        "# ----------------------------------\n",
        "# 1. CREATE HOSPITAL DATASET\n",
        "# ----------------------------------\n",
        "\n",
        "records = [\n",
        "    {\n",
        "        \"ID\": \"P1001\",\n",
        "        \"Type\": \"Discharge\",\n",
        "        \"Text\": \"Patient suffered fractures and fever. BP 120/80. Age 45 years. Discharged on 12/05/2025.\"\n",
        "    },\n",
        "    {\n",
        "        \"ID\": \"P1002\",\n",
        "        \"Type\": \"Prescription\",\n",
        "        \"Text\": \"Patient taking paracetamol 500mg twice daily. Temperature 38 C.\"\n",
        "    },\n",
        "    {\n",
        "        \"ID\": \"P1003\",\n",
        "        \"Type\": \"Operation\",\n",
        "        \"Text\": \"Patient underwent nephrectomy. Surgery completed successfully.\"\n",
        "    },\n",
        "    {\n",
        "        \"ID\": \"P1004\",\n",
        "        \"Type\": \"Nursing\",\n",
        "        \"Text\": \"Patient reporting headaches and coughing for 3 days. BP 110/70.\"\n",
        "    }\n",
        "]\n",
        "\n",
        "# Generate synthetic demonstration corpus\n",
        "hospital_data = []\n",
        "for i in range(125):\n",
        "    for record in records:\n",
        "        new_record = record.copy()\n",
        "        new_record[\"ID\"] = record[\"ID\"] + \"_\" + str(i)\n",
        "        hospital_data.append(new_record)\n",
        "\n",
        "df = pd.DataFrame(hospital_data)\n",
        "\n",
        "print(\"HOSPITAL DATASET\")\n",
        "print(df.head())\n",
        "print(\"Total Records:\", len(df))\n",
        "\n",
        "# ----------------------------------\n",
        "# 2. REGULAR EXPRESSIONS\n",
        "# ----------------------------------\n",
        "\n",
        "patterns = {\n",
        "    \"Patient ID\": r\"\\bP\\d{4}\\b\",\n",
        "    \"Date\": r\"\\b\\d{2}[/-]\\d{2}[/-]\\d{4}\\b\",\n",
        "    \"Drug Strength\": r\"\\b[A-Za-z]+\\s*\\d+\\s*mg\\b\",\n",
        "    \"Dosage Frequency\": r\"\\b(?:once|twice|thrice)\\s+daily\\b\",\n",
        "    \"Blood Pressure\": r\"\\b\\d{2,3}/\\d{2,3}\\b\",\n",
        "    \"Temperature\": r\"\\b\\d{2}(?:\\.\\d+)?\\s*(?:C|°C)\\b\",\n",
        "    \"Age\": r\"\\b\\d{1,3}\\s+years?\\b\",\n",
        "    \"ICD Code\": r\"\\b[A-Z]\\d{2}(?:\\.\\d+)?\\b\",\n",
        "    \"Phone Number\": r\"\\b\\d{10}\\b\",\n",
        "    \"Ward\": r\"\\bWard\\s+\\d+\\b\",\n",
        "    \"Bed\": r\"\\bBed\\s+\\d+\\b\",\n",
        "    \"Symptom Duration\": r\"\\b\\d+\\s+days?\\b\"\n",
        "}\n",
        "\n",
        "print(\"\\nREGEX ENTITY EXTRACTION\")\n",
        "\n",
        "for name, pattern in patterns.items():\n",
        "    matches = df[\"Text\"].str.findall(pattern).explode().dropna()\n",
        "    print(name, \":\", matches.unique()[:10])\n",
        "\n",
        "# ----------------------------------\n",
        "# 3. TOKENIZATION\n",
        "# ----------------------------------\n",
        "\n",
        "def tokenize(text):\n",
        "    pattern = r\"\\d+(?:\\.\\d+)?|[A-Za-z]+(?:[-'][A-Za-z]+)*|[^\\w\\s]\"\n",
        "    return re.findall(pattern, text)\n",
        "\n",
        "df[\"Tokens\"] = df[\"Text\"].apply(tokenize)\n",
        "\n",
        "print(\"\\nTOKENIZATION\")\n",
        "print(df[[\"Text\", \"Tokens\"]].head())\n",
        "\n",
        "# ----------------------------------\n",
        "# 4. TEXT NORMALIZATION\n",
        "# ----------------------------------\n",
        "\n",
        "abbreviations = {\n",
        "    \"BP\": \"blood pressure\",\n",
        "    \"HR\": \"heart rate\",\n",
        "    \"Temp\": \"temperature\",\n",
        "    \"Tab\": \"tablet\",\n",
        "    \"Cap\": \"capsule\",\n",
        "    \"OD\": \"once daily\",\n",
        "    \"BD\": \"twice daily\",\n",
        "    \"TDS\": \"three times daily\",\n",
        "    \"SOS\": \"when required\",\n",
        "    \"IV\": \"intravenous\"\n",
        "}\n",
        "\n",
        "def normalize(text):\n",
        "    text = text.lower()\n",
        "\n",
        "    for short, full in abbreviations.items():\n",
        "        text = re.sub(\n",
        "            r\"\\b\" + re.escape(short.lower()) + r\"\\b\",\n",
        "            full.lower(),\n",
        "            text,\n",
        "            flags=re.IGNORECASE\n",
        "        )\n",
        "\n",
        "    return text\n",
        "\n",
        "df[\"Normalized\"] = df[\"Text\"].apply(normalize)\n",
        "\n",
        "print(\"\\nNORMALIZED TEXT\")\n",
        "print(df[[\"Text\", \"Normalized\"]].head())\n",
        "\n",
        "# ----------------------------------\n",
        "# 5. FINITE STATE AUTOMATA\n",
        "# ----------------------------------\n",
        "\n",
        "def patient_id_dfa(value):\n",
        "    states = [\"q0\", \"q1\", \"q2\", \"q3\", \"q4\", \"q5\"]\n",
        "    state = \"q0\"\n",
        "\n",
        "    for char in value:\n",
        "        if state == \"q0\" and char == \"P\":\n",
        "            state = \"q1\"\n",
        "        elif state in states[1:5] and char.isdigit():\n",
        "            state = states[states.index(state) + 1]\n",
        "        else:\n",
        "            return False\n",
        "\n",
        "    return state == \"q5\"\n",
        "\n",
        "def bp_dfa(value):\n",
        "    return re.fullmatch(r\"\\d{2,3}/\\d{2,3}\", value) is not None\n",
        "\n",
        "def date_dfa(value):\n",
        "    return re.fullmatch(r\"\\d{2}/\\d{2}/\\d{4}\", value) is not None\n",
        "\n",
        "def drug_dfa(value):\n",
        "    return re.fullmatch(r\"[A-Za-z]+\\s*\\d+\\s*mg\", value) is not None\n",
        "\n",
        "print(\"\\nFINITE STATE AUTOMATA TESTING\")\n",
        "\n",
        "tests = [\n",
        "    (\"P1234\", patient_id_dfa),\n",
        "    (\"120/80\", bp_dfa),\n",
        "    (\"12/05/2025\", date_dfa),\n",
        "    (\"Paracetamol 500mg\", drug_dfa)\n",
        "]\n",
        "\n",
        "for value, machine in tests:\n",
        "    print(value, \":\", \"Accepted\" if machine(value) else \"Rejected\")\n",
        "\n",
        "# ----------------------------------\n",
        "# 6. INFLECTIONAL MORPHOLOGY\n",
        "# ----------------------------------\n",
        "\n",
        "inflection_words = [\n",
        "    \"fractures\", \"fractured\", \"fracturing\",\n",
        "    \"patients\", \"treated\", \"treating\",\n",
        "    \"diseases\", \"surgeries\", \"nurses\",\n",
        "    \"walking\", \"fevers\", \"medicines\"\n",
        "]\n",
        "\n",
        "def remove_inflection(word):\n",
        "    if word.endswith(\"ies\") and len(word) > 4:\n",
        "        return word[:-3] + \"y\"\n",
        "    elif word.endswith(\"ing\") and len(word) > 5:\n",
        "        return word[:-3]\n",
        "    elif word.endswith(\"ed\") and len(word) > 4:\n",
        "        return word[:-2]\n",
        "    elif word.endswith(\"es\") and len(word) > 4:\n",
        "        return word[:-2]\n",
        "    elif word.endswith(\"s\") and len(word) > 3:\n",
        "        return word[:-1]\n",
        "    return word\n",
        "\n",
        "print(\"\\nINFLECTIONAL MORPHOLOGY\")\n",
        "\n",
        "for word in inflection_words:\n",
        "    print(word, \"->\", remove_inflection(word))\n",
        "\n",
        "# ----------------------------------\n",
        "# 7. DERIVATIONAL MORPHOLOGY\n",
        "# ----------------------------------\n",
        "\n",
        "derivational_words = [\n",
        "    \"nephrology\", \"nephrectomy\",\n",
        "    \"infection\", \"infectious\",\n",
        "    \"treatment\", \"treatable\",\n",
        "    \"abnormal\", \"hypertension\",\n",
        "    \"hypotension\", \"arthritis\",\n",
        "    \"cardiology\", \"neurology\"\n",
        "]\n",
        "\n",
        "suffixes = [\n",
        "    \"ectomy\", \"ology\", \"itis\", \"osis\",\n",
        "    \"ation\", \"able\", \"ive\", \"al\"\n",
        "]\n",
        "\n",
        "print(\"\\nDERIVATIONAL MORPHOLOGY\")\n",
        "\n",
        "for word in derivational_words:\n",
        "    found = [s for s in suffixes if word.endswith(s)]\n",
        "    print(word, \"->\", found if found else \"No listed suffix\")\n",
        "\n",
        "# ----------------------------------\n",
        "# 8. MORPHOLOGICAL PARSING\n",
        "# ----------------------------------\n",
        "\n",
        "lexicon = {\n",
        "    \"fracture\": [\"fractures\", \"fractured\", \"fracturing\"],\n",
        "    \"patient\": [\"patients\"],\n",
        "    \"treat\": [\"treated\", \"treating\", \"treats\"],\n",
        "    \"surgery\": [\"surgeries\"],\n",
        "    \"fever\": [\"fevers\"]\n",
        "}\n",
        "\n",
        "def morphological_parse(word):\n",
        "    for stem, forms in lexicon.items():\n",
        "        if word.lower() == stem or word.lower() in forms:\n",
        "            return stem\n",
        "    return word.lower()\n",
        "\n",
        "print(\"\\nMORPHOLOGICAL PARSING\")\n",
        "\n",
        "for word in [\"fractures\", \"fractured\", \"patients\",\n",
        "             \"treated\", \"surgeries\"]:\n",
        "    print(word, \"->\", morphological_parse(word))\n",
        "\n",
        "# ----------------------------------\n",
        "# 9. PORTER STEMMER\n",
        "# ----------------------------------\n",
        "\n",
        "stemmer = PorterStemmer()\n",
        "\n",
        "words = [\n",
        "    \"fractures\", \"fractured\", \"fracturing\",\n",
        "    \"patients\", \"treating\", \"treatment\",\n",
        "    \"surgeries\", \"running\", \"connected\",\n",
        "    \"diseases\"\n",
        "]\n",
        "\n",
        "print(\"\\nPORTER STEMMER\")\n",
        "\n",
        "for word in words:\n",
        "    print(word, \"->\", stemmer.stem(word))\n",
        "\n",
        "df[\"Stemmed\"] = df[\"Normalized\"].apply(\n",
        "    lambda text: \" \".join(stemmer.stem(w) for w in tokenize(text))\n",
        ")\n",
        "\n",
        "# ----------------------------------\n",
        "# 10. SEARCH SYSTEM\n",
        "# ----------------------------------\n",
        "\n",
        "def search_records(query):\n",
        "    query = normalize(query)\n",
        "    query_stems = [\n",
        "        stemmer.stem(w) for w in tokenize(query)\n",
        "    ]\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for _, row in df.iterrows():\n",
        "        record_stems = [\n",
        "            stemmer.stem(w) for w in tokenize(row[\"Normalized\"])\n",
        "        ]\n",
        "\n",
        "        if any(word in record_stems for word in query_stems):\n",
        "            results.append(row[\"ID\"])\n",
        "\n",
        "    return results\n",
        "\n",
        "print(\"\\nHOSPITAL RECORD SEARCH\")\n",
        "\n",
        "for query in [\"fracture\", \"fever\", \"patient\", \"surgery\"]:\n",
        "    print(query, \"->\", search_records(query)[:10])\n",
        "\n",
        "# ----------------------------------\n",
        "# 11. EVALUATION\n",
        "# ----------------------------------\n",
        "\n",
        "actual = [1, 1, 0, 1, 0, 1, 0, 1]\n",
        "predicted = [1, 1, 0, 1, 1, 1, 0, 0]\n",
        "\n",
        "precision = precision_score(actual, predicted)\n",
        "recall = recall_score(actual, predicted)\n",
        "f1 = f1_score(actual, predicted)\n",
        "\n",
        "print(\"\\nEVALUATION RESULTS\")\n",
        "print(\"Precision:\", round(precision, 3))\n",
        "print(\"Recall:\", round(recall, 3))\n",
        "print(\"F1 Score:\", round(f1, 3))\n",
        "\n",
        "# ----------------------------------\n",
        "# 12. PERFORMANCE GRAPH\n",
        "# ----------------------------------\n",
        "\n",
        "results = pd.DataFrame({\n",
        "    \"Method\": [\"No Stemming\", \"Porter Stemmer\", \"Morphological Parsing\"],\n",
        "    \"Score\": [0.65, 0.82, 0.90]\n",
        "})\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.bar(results[\"Method\"], results[\"Score\"])\n",
        "plt.title(\"NLP Normalization Method Comparison\")\n",
        "plt.xlabel(\"Methods\")\n",
        "plt.ylabel(\"Illustrative Performance Score\")\n",
        "plt.ylim(0, 1)\n",
        "plt.show()\n",
        "\n",
        "# ----------------------------------\n",
        "# 13. SAVE FINAL DATASET\n",
        "# ----------------------------------\n",
        "\n",
        "df.to_csv(\"Final_Integrated_Dataset.csv\", index=False)\n",
        "\n",
        "print(\"\\nFinal dataset saved successfully!\")\n",
        "\n",
        "print(\"Total processing time:\",\n",
        "      round(time.time() - start, 3), \"seconds\")\n"
      ]
    }
