      "source": [
        " def plural(word):\n",
        "    if word.endswith(('s', 'x', 'z', 'ch', 'sh')):\n",
        "        return word + 'es'\n",
        "    elif word.endswith('y') and word[-2] not in 'aeiou':\n",
        "        return word[:-1] + 'ies'\n",
        "    else:\n",
        "        return word + 's'\n",
        "\n",
        "words = [\"cat\", \"box\", \"baby\", \"dish\"]\n",
        "\n",
        "for word in words:\n",
        "    print(word, \"->\", plural(word))"
      ]
